# mock = no AI model needed, hints come from the question's evidence sentence.
# openai = any OpenAI-compatible endpoint (Ollama locally, or a hosted model).
LLM_PROVIDER=mock

# Local example (Ollama): needs `ollama pull <model>` first.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.2
LLM_API_KEY=
